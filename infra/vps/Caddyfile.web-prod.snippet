# solidrop Web フロントエンド (prod)
# web.solidrop.nafell.dev から静的配信 + API リバースプロキシ
#
# 配置:
#   Web  (nginx): 127.0.0.1:3012
#   API  (axum) : 127.0.0.1:3002  ← /api/* と /health を透過
#
# ブラウザから見ると同一オリジンになるため CORS 設定不要

web.solidrop.nafell.dev {
    # API エンドポイントを API コンテナに透過
    handle /api/* {
        reverse_proxy http://localhost:3002
    }

    handle /health {
        reverse_proxy http://localhost:3002
    }

    # それ以外 (SPA) は nginx コンテナへ
    handle {
        reverse_proxy http://localhost:3012
    }
}
